# Copy to .env and customize. .env is gitignored.
DC_VERSION=0.3.1
SG_VERSION=4.2.1
MCP_HOST_PORT=8765
MCP_PORT=8765
MCP_PATH=/mcp
MCP_WORKSPACE_PATH=./workspace

# Open mode: only enable with compose.open.yaml and explicit warning acknowledgement.
# MCP_OPEN_WORKSPACE_PATH=/absolute/path/of/workspace-you-authorize
# MCP_OPEN_ACK=I_ACCEPT_OPEN_MODE_RISKS

# Secure MCP Tunnel: only needed with compose.tunnel.yaml and --profile tunnel.
# CONTROL_PLANE_TUNNEL_ID=tunnel_...
# CONTROL_PLANE_API_KEY_FILE=./secrets/control-plane-api-key
